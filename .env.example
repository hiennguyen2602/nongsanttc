APP_NAME="Nông Sản TTC"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

# Dung lượng tối đa mỗi ảnh upload (MB). Phải nhỏ hơn upload_max_filesize của PHP (25M trong docker/php/uploads.ini).
# Tổng body POST tối đa 50M (post_max_size + nginx client_max_body_size).
MAX_IMAGE_UPLOAD_MB=20

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
# 10080 phút = 7 ngày (không tick "Ghi nhớ"). Tick "Ghi nhớ" = 30 ngày (cookie remember).
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
# Production HTTPS: SESSION_SECURE_COOKIE=true (mặc định tự bật khi APP_ENV=production)
# Không set SESSION_DOMAIN, hoặc để trống — KHÔNG ghi SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=nongsanttc2026@gmail.com
MAIL_PASSWORD="remzkowzvzysrokf"
MAIL_SCHEME=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=nongsanttc2026@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

